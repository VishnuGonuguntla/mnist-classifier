# .clang-tidy for mnist-classifier
# This configuration focuses on performance (crucial for math/tensors),
# readability, and avoiding common C++ pitfalls.

# Enable all checks by default, then selectively disable
Checks: 'bugprone-*,
         clang-analyzer-*,
         google-*,
         modernize-*,
         performance-*,
         portability-*,
         readability-*,
         -cppcoreguidelines-pro-bounds-pointer-arithmetic,
         -cppcoreguidelines-pro-type-vararg,
         -modernize-use-trailing-return-type,
         -readability-braces-around-statements,
         -readability-magic-numbers'

# Treat all warnings as errors to maintain high code quality
WarningsAsErrors: '*'

# Header filter to ensure we only check project headers, not system libraries
HeaderFilterRegex: 'include/.*|src/.*'

# Crucial for the error you saw: Do not parse system headers for tidy checks
AnalyzeTemporaryDtors: false
FormatStyle: file
User: vishnu-gonuguntla

CheckOptions:
  - key:             readability-identifier-naming.ClassCase
    value:           CamelCase
  - key:             readability-identifier-naming.FunctionCase
    value:           camelBack
  - key:             readability-identifier-naming.VariableCase
    value:           lower_case
  - key:             performance-for-range-copy.WarnOnAllAutoCopies
    value:           'true'
...